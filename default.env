# The settings are in .env, use "nano .env". Don't edit default.env itself.
COMPOSE_FILE=morph.yml

# Further variables such as RPC, WS ports, P2P ports, NETWORk, SNAPSHOT, LOG_LEVEL, &c
NETWORK=morph
GETH_VERSION=2.2.2
NODE_VERSION=0.5.5
GETH_P2P_PORT=30303
NODE_P2P_PORT=26656
MORPH_FLAG=morph
SNAPSHOT=https://snapshot.morphl2.io/mainnet/snapshot-20260509-1.tar.gz
L1_ETH_RPC=
L1_BEACON_CHAIN_RPC=
L1_CHAIN_ID=1
L1MESSAGEQUEUE_CONTRACT=0x3931ade842f5bb8763164bdd81e5361dce6cc1ef
ROLLUP_CONTRACT=0x759894ced0e6af42c26668076ffa84d02e3cef60
DERIVATION_START_HEIGHT=24883902
L1_MSG_START_HEIGHT=24883052
L2_BASE_HEIGHT=22181317
NODE_EXTRA_FLAGS=--mainnet

# Secure web proxy - advanced use, please see instructions
DOMAIN=example.com
RPC_HOST=morph
RPC_LB=morph-lb
WS_HOST=morphws
WS_LB=morphws-lb

# IP of the host you want to use in Docker (in case host has several IPs)
HOST_IP=
# IP address to use when host-mapping a port through *-shared.yml. Set this to 127.0.0.1 to restrict the share to localhost
SHARE_IP=

# External Docker network if using ext-network.yml
DOCKER_EXT_NETWORK=traefik_default

# Set a Github tag here to pin the script to a version.
SCRIPT_TAG=

# Used by script update - please do not adjust
ENV_VERSION=1
